{
    "name": "publishpress/pimple-pimple",
    "version": "3.5.0.11",
    "type": "library",
    "description": "Pimple, a simple Dependency Injection Container, prefixed for PublishPress",
    "keywords": [
        "dependency injection",
        "container",
        "publishpress"
    ],
    "homepage": "https://github.com/silexphp/Pimple/",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "PublishPress",
            "email": "help@publishpress.com"
        }
    ],
    "autoload": {
        "files": [
            "lib/include.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Helper\\": "tests/_support/Helper/"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "publishpress/psr-container": "^2.0.1.10"
    },
    "require-dev": {
        "pimple/pimple": "3.5.0",
        "brianhenryie/strauss": "0.29.2",
        "publishpress/version-loader-generator": "^1.0",
        "publishpress/dev-workspace": "^1.8"
    },
    "extra": {
        "plugin-name": "library-pimple-pimple",
        "plugin-slug": "library-pimple-pimple",
        "plugin-folder": "library-pimple-pimple",
        "plugin-lang-domain": "pimple-pimple",
        "plugin-github-repo": "publishpress/library-pimple-pimple",
        "plugin-composer-package": "publishpress/pimple-pimple",
        "generator": {
            "lib-class-test": "class_exists('PublishPress\\Pimple\\Container', false)",
            "action-register-priority": "-200",
            "action-initialize-priority": "-185"
        },
        "strauss": {
            "target_directory": "lib",
            "namespace_prefix": "PublishPress\\",
            "classmap_prefix": "PublishPress_",
            "constant_prefix": "PUBLISHPRESS_",
            "include_author": true,
            "classmap_output": true,
            "packages": [
                "pimple/pimple",
                "psr/container"
            ],
            "delete_vendor_packages": true,
            "delete_vendor_files": true
        }
    },
    "scripts": {
        "strauss": [
            "vendor/bin/strauss"
        ],
        "update-autoloader": [
            "php scripts/post-update.php"
        ],
        "generate-files": [
            "vendor/bin/version-loader-generator",
            "php tests/bin/guard-generated-include.php",
            "php tests/bin/patch-version-loader-cest.php"
        ],
        "post-install-cmd": [
            "@strauss",
            "@update-autoloader",
            "@generate-files"
        ],
        "post-update-cmd": [
            "@strauss",
            "@update-autoloader",
            "@generate-files"
        ],
        "test:unit": "vendor/bin/codecept run Unit",
        "test:integration": [
            "bash tests/bin/fix-linux-test-volume-perms.sh",
            "vendor/bin/codecept run Integration"
        ],
        "test:all": [
            "@test:unit",
            "@test:integration"
        ]
    },
    "config": {
        "allow-plugins": {
            "publishpress/dev-workspace": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
